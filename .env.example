# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# Transaction pooler (required for IPv4 on Supabase free tier)
DATABASE_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=3&connect_timeout=15&pool_timeout=30&sslmode=require
# Session/migration pooler (Prisma migrate requires a direct connection)
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-at-least-32-random-characters-keep-secret
SESSION_SECRET=replace-with-another-32-char-random-string

# ─── App URLs ─────────────────────────────────────────────────────────────────
CUSTOMER_URL=http://localhost:3002
ADMIN_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api/v1

# ─── Admin Seed Account (used only by npm run db:seed) ────────────────────────
ADMIN_NAME=Shadow Shop Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# ─── OTP Settings ─────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ─── Email Provider ───────────────────────────────────────────────────────────
# Set EMAIL_PROVIDER to: resend | smtp | gas | none
# "none"  → OTPs printed to console (dev only). Production will warn.
# "resend"→ Recommended. Fast, reliable, bypasses port 587 blocks on Render.
# "smtp"  → Use your own SMTP server (Gmail, SendGrid, etc.)
# "gas"   → Google Apps Script relay (legacy, not recommended)
EMAIL_PROVIDER=none

# Sender identity (required for resend and smtp)
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=SHADOW SHOP

# Store contact emails (shown in email footers and admin notifications)
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com

# ─── Resend (primary / recommended) ──────────────────────────────────────────
# Get your key at https://resend.com → API Keys
# IMPORTANT: You MUST verify your sending domain in the Resend dashboard.
# Sending from an unverified domain will result in 403 errors.
RESEND_API_KEY=

# ─── SMTP (optional fallback) ─────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Google Apps Script relay (legacy optional) ───────────────────────────────
GAS_WEBHOOK_URL=

# ─── SMS (separate system, not required for email OTP) ────────────────────────
SMS_PROVIDER=none
SMS_API_KEY=
SMS_WEBHOOK_URL=

# ─── Dev helpers ──────────────────────────────────────────────────────────────
# If set, admin email test will default to this address instead of prompting
EMAIL_TEST_TO=

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_PROVIDER=local
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=8

# ─── Supabase Storage (optional, for cloud uploads) ───────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── Maps ─────────────────────────────────────────────────────────────────────
MAP_PROVIDER=openstreetmap
MAP_API_KEY=

# ─── Payment ──────────────────────────────────────────────────────────────────
PAYMENT_PROVIDER=cod
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# ─── Frontend (Vite — these are public, prefix with VITE_) ───────────────────
# LocationIQ key for address autocomplete (get free key at locationiq.com)
VITE_LOCATION_IQ_API_KEY=
VITE_CUSTOMER_URL=http://localhost:3002
