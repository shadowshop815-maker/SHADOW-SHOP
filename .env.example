# Runtime
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://shadow:shadow_dev_password@localhost:5432/shadow_shop?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_SECRET=replace-with-another-long-random-secret
CUSTOMER_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
BACKEND_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000/api/v1

# Initial administrator (used only by npm run db:seed)
ADMIN_NAME=Shadow Shop Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
SMS_PROVIDER=none
SMS_API_KEY=
SMS_WEBHOOK_URL=
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Uploads, maps, and payment extension points
UPLOAD_PROVIDER=local
UPLOAD_PATH=uploads
MAX_UPLOAD_MB=8
MAP_PROVIDER=openstreetmap
MAP_API_KEY=
PAYMENT_PROVIDER=cod
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=
